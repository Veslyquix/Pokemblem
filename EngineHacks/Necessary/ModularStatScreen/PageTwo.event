  // RMenu(Inventory_Crt,0,Inventory_Hit,0,0xae,0x88,0x560)

POP 

ALIGN 4 

IT_ClassA:
  RMenu(IT_HPA,IT_LevelA,InventoryRtext1,InventoryRtext1,0x18,0x50,0x6E8,ClassDescGetter) 
