#ifdef CASUAL_MODE


// eid $B0 enables Casual Mode (fallen units come back next chapter).
// hack by circleseverywhere

#ifdef _FE8_

  {

  PUSH
    ORG $18418
      jumpToHack(CasualMode)
  POP

#include "CasualMode.lyn.event" 

  }
  
  ALIGN 4 
  PUSH; ORG CURRENTOFFSET+1; 
  SetDifficultyASMC:
  POP 
  #incbin "fe8difficultyswitching.dmp" 


// #define SetDiff(value) "SVAL s1 value; ASMC SetDifficultyASMC" 
#define ForceLunatic "SVAL s1 2; ASMC SetDifficultyASMC" 


#else // _FE8_
  ERROR Casual mode hack is for FE8
#endif // _FE8_

#endif // CASUAL_MODE
