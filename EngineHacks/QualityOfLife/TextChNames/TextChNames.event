#ifdef TEXT_CHAPTER_NAMES


// Chapter Names as Text.
// Hack by circleseverywhere
// Extended Latin charset support by hypergammaspaces
#include "asm/status_screen.lyn.event" 



#ifdef _FE8_
  ALIGN 4
  #include "asm/chapter_title_utf8.lyn.event"
  {

  #include "EAstdlib.event"
  #include "Extensions/Hack Installation.txt"

  PUSH
  ORG $8E7F4 
  jumpToHack(status_screen_ch_name) 
  
    ORG $89624
      jumpToHack(Chname)
  POP



  Chname:
    #include "asm/fe8_chapter_names.lyn.event"
  Font_Graphic_Ptr:
    POIN ChFont
  FontDimensionsTable:
    POIN ChTable
	AltChapterTitleTable:
	POIN ChTable 
	ChapterID_Ram:
	WORD 0xE000000 + $352F // Savefile 1 + offset to chapter ID 
	SaveslotSize:
	WORD $1344 // size 
	Utf8FindGlyph:
	POIN ChapterTitleFindUtf8Glyph
	Utf8DrawGlyph:
	POIN ChapterTitleDrawUtf8Glyph
	// savefile 2: 4873 
	// savefile 3: 5BB7 
// suspend: E00015A 
  ChFont:
    //#incext Png2Dmp "bin/font.png" --lz77
    #incbin "bin/font-extended.dmp"

  ChTable:
    #incbin "bin/chartable-extended.dmp"

  }

#else // _FE8_
  ERROR Chapter Names as Text hack is for FE8
#endif // _FE8_

#endif // TEXT_CHAPTER_NAMES



