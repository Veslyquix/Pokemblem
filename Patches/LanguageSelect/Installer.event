PUSH
ORG 0x591710 // poin ProcScr_GameEarlyStartUI (H&S)
// ORG 0x0C542C
POIN LanguageSelectProcCmd

ORG $a8d4c 
callHackNew(Hook_LoadDifficultyGfx) 
ORG $aa392 
