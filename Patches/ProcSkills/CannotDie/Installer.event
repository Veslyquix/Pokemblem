#include "eastdlib.event" 

#ifndef callHackNew 
	#define callHackNew(offset) 		"BYTE $01 $4B $9E $46 $00 $F8 $01 $E0; POIN (offset|0x1)"
#endif 

ALIGN 4; PUSH; ORG CurrentOffset+1; CannotDieEffect: ; POP 
#incbin "CannotDie.dmp" 
POIN CannotDieList 

ALIGN 4 
CannotDieList: 
// unitID, classID, flag 
// if the flag is ON, then they are no longer immune to death 
BYTE 0xEE MoltresID; SHORT MoltresFledFlag 
BYTE 0xDE MoltresID; SHORT MoltresFledFlag // they're 2 unit IDs iirc 2026 
BYTE 0xEE ArticunoID; SHORT ArticunoFledFlag 
BYTE 0xDE ArticunoID; SHORT ArticunoFledFlag 
BYTE 0xEE ZapdosID; SHORT ZapdosFledFlag 
BYTE 0xDE ZapdosID; SHORT ZapdosFledFlag 
BYTE 0xD0 MewID; SHORT MewFledFlag 
WORD 0xFFFFFFFF  // Terminator 




PUSH 
ORG $2B87C
callHackNew(CannotDieEffect)
POP 



