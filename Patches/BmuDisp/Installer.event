#include "C_Code.lyn.event" 
#include "../QoL_Testing.event" 
#include "../../../ASM/Debugger/Installer.event" 

#define BlueArrowChr 0x240 
#define ArrChr "0x3800|BlueArrowChr"


PUSH 
ORG $32E9C // Blue Arrow from PathArrowDisp_Init
WORD (0x6010000 + (BlueArrowChr << 5))

ORG $59db6c // gPathArrowOAMTable[5][5] = {
SHORT ArrChr|0x0 ArrChr|0x14 ArrChr|0x16 ArrChr|0x10 ArrChr|0x12
SHORT ArrChr|0x0 ArrChr|0x0  ArrChr|0x08 ArrChr|0x1C ArrChr|0x0C
SHORT ArrChr|0x2 ArrChr|0x8  ArrChr|0x02 ArrChr|0x0A ArrChr|0x18
SHORT ArrChr|0x4 ArrChr|0x1E ArrChr|0x0A ArrChr|0x04 ArrChr|0x0E
SHORT ArrChr|0x6 ArrChr|0xC  ArrChr|0x1A ArrChr|0x0E ArrChr|0x06

POP 

