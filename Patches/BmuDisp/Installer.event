// then, move faces during conversations to 0x6013000 from 0x6015000

// UseUnitSprite needs to be uncommented for vanilla build 


#include "C_Code.lyn.event" 


#define BlueArrowChr 0x240 
#define ArrChr "0x3800|BlueArrowChr"
#define BottomHelpChr 0x384 
#define MMSChr 0x0C // 0x380 default 

ALIGN 4 
TradeLeftFaceChr:
WORD 0x18 
TradeRightFaceChr: 
WORD 0x58 

PUSH 

// can't use MMSChr definition because the value is obtained via mov + lsl 
ORG $78572 
SHORT $250C // Default MMS as tile 0xC instead of 0x380 
SHORT $46c0 
ORG $79754 
SHORT $220C // Default MMS as tile 0xC instead of 0x380  
SHORT $46c0 


ORG $32E9C // Blue Arrow from PathArrowDisp_Init
WORD (0x6010000 + (BlueArrowChr << 5))

ORG $59db6c // gPathArrowOAMTable[5][5] = {
SHORT ArrChr|0x0 ArrChr|0x14 ArrChr|0x16 ArrChr|0x10 ArrChr|0x12
SHORT ArrChr|0x0 ArrChr|0x0  ArrChr|0x08 ArrChr|0x1C ArrChr|0x0C
SHORT ArrChr|0x2 ArrChr|0x8  ArrChr|0x02 ArrChr|0x0A ArrChr|0x18
SHORT ArrChr|0x4 ArrChr|0x1E ArrChr|0x0A ArrChr|0x04 ArrChr|0x0E
SHORT ArrChr|0x6 ArrChr|0xC  ArrChr|0x1A ArrChr|0x0E ArrChr|0x06

// PutSubtitleHelpText
ORG $355A4 // "Select an item to send to supply / discard" 	//{U}
//ORG $354AC // "Select an item to send to supply / discard"		//{J}
WORD (0x6010000 + (BottomHelpChr << 5)) // 14800 vanilla 

ORG $354D8		//{U}
//ORG $353E0		//{J}
SHORT 0x4000|BottomHelpChr // 4240 vanilla 

// 7743 did this fix by directly editing the oam table in rom instead of replacing the poin as I did 
ORG $354D4 // from 0x803547C called by 356BC Procs BottomHelpText CallASM
POIN SomeNewOAMTable

//Make scrolling help text only clear space for one line. (It doesn't seem to need it anyway.
//https://discord.com/channels/144670830150811649/725478895226191892/1219846780590751845
ORG $3552A	//{U}
//ORG $35432	//{J}
SHORT 0x46C0 //Remove loop branch so code only runs once

POP 

