ALIGN 4 
SkillUsabilityTable:
FILL(256*4) 

// stat types: 
/* 
    u16 hp  : 1; // 0x01
    u16 str : 1; // 0x02 
    u16 skl : 1; // 0x04
    u16 spd : 1; // 0x08 
    u16 def : 1; // 0x10 
    u16 res : 1; // 0x20 
    u16 mag : 1; // 0x40 
*/
#define hpReq 0x01 
#define strReq 0x02 
#define sklReq 0x04 
#define spdReq 0x08 
#define defReq 0x10 
#define resReq 0x20 
#define magReq 0x40 
#define lckReq 0x80 

#define SkillReq(id, typing, statReq, statType) "PUSH; ORG SkillUsabilityTable + (4 * id); SHORT typing; BYTE statReq statType; POP" 

 



// Viridian Mart 
SkillReq(PoisonStrikeID, PoisonType, 50, defReq|resReq) 

// Pewter Mart 
