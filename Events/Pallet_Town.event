VisitHome:

CHECK_EVENTID CinnabarMomCallFlag
BEQ 0 sC s0 
CHECK_EVENTID MomGaveItemFlag 
BNE 0 sC s0 

SVAL r3 20000 
GIVETOMAIN 0 
GiveItemWithDurability_Rand(0, SpellScroll, Rest)
SetBG(Pallet_Ash_house_BG)
Text(MomGiveItemText)
ENUT MomGaveItemFlag 


GOTO 5 
LABEL 0 
SetBG(Pallet_Ash_house_BG)
LABEL 5 

CHECK_EVENTID CompletedPokemonLeague
BEQ 1 sC s0 
Text(MomPostLeagueText)
GOTO 10 
LABEL 1

Text(MomWelcomeHomeText)
LABEL 10
CALL VisitPokecenter
NoFade 
ENDA 


TutMsg1: 
CHECK_EVENTID DisableTutMsgsFlag
BNE 99 sC s0 
ENUF DisableTutFlag_A
SVAL s1 ((ChapterID*2)+(HelpMsgFlagOffset<<3)) 
ASMC CheckNewFlag_ASMC 
BNE 99 sC s0 
CountPlayersInRange_ASMC(0,0,23,19) 
BEQ 99 sC s0 
ENUT DisableTutFlag_A
EVBIT_MODIFY 4
PauseFreeMovement
STAL 5
CAM1 [5,14]
CUMO [5,14]
STAL 30
CURE  
TutText(PalletTrainerTipsText)
SVAL s1 ((ChapterID*2)+(HelpMsgFlagOffset<<3)) 
ASMC SetNewFlag_ASMC 
LABEL 99 
NoFade 
ENDA 


